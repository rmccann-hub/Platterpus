{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__github__actions_list",
      "mcp__github__pull_request_read",
      "mcp__github__actions_get",
      "mcp__github__get_job_logs",
      "mcp__github__get_release_by_tag",
      "mcp__github__list_releases",
      "mcp__github__get_commit",
      "mcp__github__get_check_run"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -qiE '\\.(flac|wav|mp3|m4a|aac|ogg|oga|opus|wv|ape|wma|aiff|aif|alac|dsf|dff)$' && { echo 'Blocked: audio/copyrighted media is staged (CLAUDE.md Critical Rule #8). Unstage it (git restore --staged <file>); test audio outside the repo.' >&2; exit 2; } || exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
